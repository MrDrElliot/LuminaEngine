<Project Sdk="Microsoft.NET.Sdk">

  <!-- Managed engine API, loaded at run time by FDotNetHost. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LuminaSharp</AssemblyName>
    <RootNamespace>LuminaSharp</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Deterministic>true</Deterministic>
    <Configurations>Debug;Development;Shipping</Configurations>

    <!-- Loaded into a collectible load context, so it must carry its own dependency manifest. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\..\Binaries\Windows64\DotNet\Managed\</OutputPath>
    <!-- BaseIntermediateOutputPath is set in Directory.Build.props; it is read too early to set here. -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />

    <!-- Referenced as an analyzer, not as a library. -->
    <ProjectReference Include="..\LuminaSharp.Generators\LuminaSharp.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bindings emitted by the Reflector. Globbed by MSBuild rather than listed, because they do
         not exist until the reflection step has run. -->
    <Compile Include="$(MSBuildThisFileDirectory)..\..\..\Intermediates\CSharpBindings\**\*.generated.cs">
      <Link>Generated\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <!-- The [Property] type classifier, shared BY SOURCE with the analyzer. It cannot be shared by
         reference: the generator is referenced as an analyzer (ReferenceOutputAssembly="false"), and it
         targets netstandard2.0 so it could not reference this project either. Both already reference
         Microsoft.CodeAnalysis, which is all the file needs. See ScriptPropertyModel.cs. -->
    <Compile Include="$(MSBuildThisFileDirectory)..\LuminaSharp.Generators\Shared\ScriptPropertyModel.cs">
      <Link>Scripting\Shared\ScriptPropertyModel.cs</Link>
    </Compile>
  </ItemGroup>

  <!-- The runtime script compiler loads the generator itself, so it has to sit beside this assembly. -->
  <Target Name="CopyGeneratorForRuntime" AfterTargets="Build">
    <Copy SourceFiles="@(Analyzer)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="'%(Filename)' == 'LuminaSharp.Generators'" />
  </Target>

</Project>
