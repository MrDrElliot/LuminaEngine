{
    "FormatVersion": 1,
    "Name": "RenderDoc",
    "Version": 1,
    "VersionName": "0.1.0",
    "Author": "Lumina Team",
    "Description": "RenderDoc frame capture from the editor's Tools menu. Launch the editor with -renderdoc to load RenderDoc before the Vulkan device exists, or launch it from RenderDoc itself. Uses the installed RenderDoc whose Vulkan layer is registered, and falls back to External/RenderDoc.",
    "Category": "Profiling",
    "EnabledByDefault": true,
    "EditorOnly": true,
    "ContainsContent": false,
    "SupportedPlatforms": [ "Windows", "Linux" ],
    "Dependencies": [],
    "Modules": [
        {
            "Name": "RenderDocEditor",
            "Type": "Editor",
            "LoadingPhase": "Core"
        }
    ]
}
