/* Slot layout for the HUD. Only the slots live here; the widgets that fill them bring their own styling. */

div { display: block; box-sizing: border-box; }

body { width: 100%; height: 100%; }

/* Every slot is absolutely positioned with an EXPLICIT width and height. */
/* RmlUi falls back to the left/top edge when the opposing size is auto, so right/bottom would not resolve. */

#topleft
{
	position: absolute;
	left: 26dp;
	top: 26dp;
	width: 240dp;
	height: 70dp;
}

#topright
{
	position: absolute;
	right: 26dp;
	top: 26dp;
	width: 150dp;
	height: 150dp;
}

#center
{
	position: absolute;
	left: 0dp;
	bottom: 130dp;
	width: 100%;
	height: 44dp;
	display: flex;
	justify-content: center;
	align-items: center;
}

#bottomright
{
	position: absolute;
	right: 26dp;
	bottom: 26dp;
	width: 128dp;
	height: 128dp;
}
