<rml>
<!-- The composed form of Hud.rml, and exactly what the editor's Composition panel writes when you drag -->
<!-- widgets onto the slots: one <link> per widget, plus an inline <template src> inside each slot. -->
<head>
    <title>HUD (composed)</title>
    <link type="text/rcss" href="Hud.rcss"/>
    <link type="text/template" href="StatBar.rml"/>
    <link type="text/template" href="Radar.rml"/>
    <link type="text/template" href="Objective.rml"/>
    <link type="text/template" href="Gauge.rml"/>
</head>

<!-- One model drives all four widgets; none of them carries a script of its own. -->
<body data-model="hud">
    <div id="topleft">
        <template src="statbar"/>
    </div>
    <div id="topright">
        <template src="radar"/>
    </div>
    <div id="center">
        <template src="objective"/>
    </div>
    <div id="bottomright">
        <template src="gauge"/>
    </div>
</body>
</rml>
