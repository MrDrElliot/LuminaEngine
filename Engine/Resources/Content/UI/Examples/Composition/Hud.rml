<rml>
<head>
    <title>HUD (empty slots)</title>
    <link type="text/rcss" href="Hud.rcss"/>
    <link type="text/template" href="StatBar.rml"/>
    <link type="text/template" href="Radar.rml"/>
    <link type="text/template" href="Objective.rml"/>
    <link type="text/template" href="Gauge.rml"/>
</head>

<!-- data-model="hud" binds the HUD and every widget slotted into it to the HudModel from HudExample.cs. -->
<body data-model="hud">
    <!-- Each id'd div is an empty slot positioned by Hud.rcss, and stays empty on purpose. -->
    <!-- Open this in the editor, then drag a widget from the Palette onto a slot to fill it in. -->
    <!-- HudComposed.rml is the same document once all four slots are filled. -->
    <div id="topleft"></div>
    <div id="topright"></div>
    <div id="center"></div>
    <div id="bottomright"></div>
</body>
</rml>
