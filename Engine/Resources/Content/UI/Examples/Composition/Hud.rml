<rml>
<head>
    <title>HUD Composition</title>
    <link type="text/rcss" href="Hud.rcss"/>
    <link type="text/template" href="Clock.rml"/>
    <link type="text/template" href="HealthBar.rml"/>
    <link type="text/template" href="Minimap.rml"/>
</head>
<!-- data-model="hud" binds the whole HUD (and every composed widget) to the HudModel from HudExample.cs. -->
<body data-model="hud">
    <!-- Each id'd div is an empty slot, positioned by Hud.rcss. Drag a widget from the Palette's Widgets
         list onto one (or select a slot and double-click a widget) to fill it in; Ctrl+drag in the preview
         canvas to nudge it (writes transform:translate, so it stays responsive). HudComposed.rml is what
         this looks like once all three are filled. -->
    <div id="topbar"></div>
    <div id="hp"></div>
    <div id="minimap"></div>
</body>
</rml>
