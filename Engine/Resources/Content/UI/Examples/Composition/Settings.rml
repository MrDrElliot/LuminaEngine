<rml>
<!-- Whole-document composition: <body template="window"> wraps this entire body in Window.rml's chrome, -->
<!-- and everything below lands in that template's #window-content slot. -->
<head>
    <title>Settings</title>
    <link type="text/rcss" href="/Engine/Resources/Content/UI/Examples/Theme.rcss"/>
    <link type="text/template" href="Window.rml"/>
    <style>
        body { display: flex; align-items: center; justify-content: center;
               background-color: #11111baa; }
        .kv { display: flex; justify-content: space-between; align-items: center; padding: 9dp 0dp; }
        .kv .val { color: #a6e3a1; font-family: JetBrains Mono; font-weight: bold; }
    </style>
</head>

<!-- Same model as Menu.rml: data models belong to the context, so any document in it can bind to one. -->
<body template="window" data-model="menu">

    <div class="kv">
        <span>Master volume</span>
        <span class="row">
            <input type="range" min="0" max="100" step="5" data-value="Volume"/>
            <span class="val">{{ Volume }}</span>
        </span>
    </div>

    <div class="kv">
        <span>Fullscreen</span>
        <input type="checkbox" data-checked="Fullscreen"/>
    </div>

    <div class="kv">
        <span>Quality</span>
        <select data-value="Quality">
            <option value="low">Low</option>
            <option value="high">High</option>
            <option value="ultra">Ultra</option>
        </select>
    </div>

    <div class="divider"/>

    <div class="row" style="justify-content: flex-end;">
        <div class="btn ghost" data-event-click="ApplyPreset('low')">Low preset</div>
        <div class="btn primary" data-event-click="CloseSettings()">Done</div>
    </div>

</body>
</rml>
