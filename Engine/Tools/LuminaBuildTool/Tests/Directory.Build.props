  <PropertyGroup>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\..\..\..\Intermediates\BuildTool\obj.tests\</BaseIntermediateOutputPath>
  </PropertyGroup>

</Project>
